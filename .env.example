# Copy this file to .env and fill in your own keys. Never commit .env or paste keys into chat.

# Meta Model API key (dev.meta.ai > API keys): SAM 3.1 and Muse Spark 1.3.
MODEL_API_KEY=

# Where Spark's thinking runs: meta (Muse Spark 1.3 through the Meta Model API)
# or baseten (Muse Spark Open, the open weights, hosted by Baseten).
SPARK_PROVIDER=meta
BASETEN_API_KEY=

# Open-weight masks (--masks open) run SAM 3.1 on a Modal GPU; Modal keeps its own token after
# `modal setup`, and the Hugging Face token lives in a Modal secret named "huggingface":
#   modal secret create huggingface HF_TOKEN=hf_...
#   modal deploy scripts/sam_modal.py
